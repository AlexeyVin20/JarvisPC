# ==== Jarvis PC configuration ====
# Copy to .env and fill in. Shared by docker-compose and the backend.

# Gemini API key (https://aistudio.google.com/apikey) — required
GEMINI_API_KEY=

# Models (defaults match VoxRelay)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_MEMORY_MODEL=gemini-3.8-flash

# --- Google sign-in (optional): use a Google account instead of a manual key.
# Create an OAuth 2.0 "Desktop app" client in Google Cloud Console
# (APIs & Services -> Credentials), enable "Generative Language API",
# and register this redirect URI in the client:
#   http://localhost:8787/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
WEB_ORIGIN=http://localhost:3000
# Override scopes only if you know what you're doing (space-separated)
# OAUTH_SCOPES=https://www.googleapis.com/auth/generative-language openid email

# PostgreSQL (docker-compose service)
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5433/jarvis

# Backend server
JARVIS_HOST=0.0.0.0
JARVIS_PORT=8787

# Browser voice channel sample rate (24kHz = native Gemini output quality)
WEB_SAMPLE_RATE=24000

# Local 4get metasearch endpoint (docker-compose service)
WEBSEARCH_ENDPOINT=http://localhost/web

# Frontend origins allowed to call the API
JARVIS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
